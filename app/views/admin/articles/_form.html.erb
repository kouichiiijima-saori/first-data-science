<%= form_with model: [:admin, article], local: true, data: { controller: "article-editor-mode rich-text-editor", rich_text_editor_upload_url_value: admin_article_images_path } do |form| %>
  <% if article.errors.any? %>
    <div class="error-explanation">
      <h2><%= article.errors.count %>件のエラーにより保存できませんでした：</h2>
      <ul>
        <% article.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :title, "タイトル" %>
    <p class="form-help">タイトルは<%= Article::TITLE_MAX_LENGTH %>文字以内で入力してください。</p>
    <%= form.text_field :title, required: true, maxlength: Article::TITLE_MAX_LENGTH %>
  </div>

  <div class="form-group">
    <%= form.label :summary, "概要" %>
    <p class="form-help">記事一覧や検索結果に表示される簡単な説明文です。概要は<%= Article::SUMMARY_MAX_LENGTH %>文字以内で入力してください。</p>
    <%= form.text_area :summary, required: true, rows: 3, maxlength: Article::SUMMARY_MAX_LENGTH %>
  </div>

  <div class="form-group">
    <%= form.label :editor_type, "編集方式" %>
    <% if article.persisted? %>
      <p class="form-help">保存済み記事の編集方式は変更できません。本文の自動変換は行いません。</p>
      <%= form.hidden_field :editor_type, id: nil, data: { article_editor_mode_target: "selector" } %>
      <%= form.select :editor_type, Article.editor_type_options, {}, disabled: true %>
    <% else %>
      <p class="form-help">Markdownまたはリッチテキストを選択できます。保存後の編集方式は変更できません。</p>
      <%= form.select :editor_type, Article.editor_type_options, {}, required: true, data: { article_editor_mode_target: "selector", action: "change->article-editor-mode#change" } %>
    <% end %>
  </div>

  <% rich_text_mode = article.editor_type == "rich_text" %>

  <div class="form-group<%= " editor-mode-hidden" if rich_text_mode %>" data-article-editor-mode-target="markdownPanel" data-controller="markdown-preview" data-markdown-preview-url-value="<%= admin_markdown_preview_path %>" <%= "hidden" if rich_text_mode %>>
    <div class="markdown-preview-header">
      <%= form.label :body, "本文 (Markdown)", class: "markdown-preview-label", for: "article_body_markdown" %>
      <button type="button" class="btn btn-secondary markdown-preview-button" data-markdown-preview-target="button" data-action="click->markdown-preview#preview">プレビューを実行する</button>
    </div>
    <p class="form-help">
      <strong>Markdown記法が使えます：</strong> 見出しは <code># </code>、箇条書きは <code>- </code>、太字は <code>**太字**</code>、リンクは <code>[テキスト](URL)</code>。<br>
      コードブロックは <code>```ruby</code> のように言語を指定します。本文は表示上の文字数で<%= Article::MINIMUM_BODY_PLAIN_TEXT_LENGTH %>文字以上、Markdown原文で最大15,000文字以内です。
    </p>

    <div class="markdown-editor-layout">
      <%= form.text_area :body, id: "article_body_markdown", required: true, maxlength: Article::BODY_MAX_LENGTH, class: "markdown-textarea", disabled: rich_text_mode, data: { markdown_preview_target: "source", article_editor_mode_target: "markdownBody" } %>

      <div class="preview-area">
        <h3 class="preview-area-title">プレビュー結果</h3>
        <div data-markdown-preview-target="preview">
          <div class="preview-empty">
            まだプレビューされていません。「プレビューを実行する」ボタンを押すとここに表示されます。
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="form-group<%= " editor-mode-hidden" unless rich_text_mode %>" data-article-editor-mode-target="richTextPanel" <%= "hidden" unless rich_text_mode %>>
    <%= form.label :body, "本文 (リッチテキスト)", for: "article_body_rich_text" %>
    <p class="form-help">段落、見出し2〜4、文字サイズ、文字色、下線、URLリンクを設定できます。本文は表示上の文字数で<%= Article::MINIMUM_BODY_PLAIN_TEXT_LENGTH %>文字以上、最大<%= number_with_delimiter(Article::RICH_TEXT_TEXT_MAX_LENGTH) %>文字以内、HTML全体で最大<%= number_with_delimiter(Article::RICH_TEXT_HTML_MAX_LENGTH) %>文字以内です。</p>
    <%= form.text_area :body, id: "article_body_rich_text", required: true, maxlength: Article::RICH_TEXT_HTML_MAX_LENGTH, class: "rich-text-editor-fallback", disabled: !rich_text_mode, data: { rich_text_editor_target: "source", article_editor_mode_target: "richTextBody" } %>
    <div data-rich-text-editor-target="bodyImageList">
      <% Array(body_image_signed_ids).each do |signed_id| %>
        <%= hidden_field_tag "article[body_image_signed_ids][]", signed_id, data: { rich_text_editor_target: "bodyImageSignedId" } %>
      <% end %>
    </div>
  </div>

  <div class="form-group">
    <%= form.label :tag_names, "タグ" %>
    <p class="form-help">カンマ区切りで複数指定できます（例: Python, 機械学習, 統計）。タグは1件<%= Tag::NAME_MAX_LENGTH %>文字以内、最大<%= Article::MAX_TAGS_PER_ARTICLE %>件です。</p>
    <%= form.text_field :tag_names, value: tag_names, maxlength: Article::TAG_NAMES_MAX_LENGTH %>
  </div>

  <div class="form-group">
    <%= form.label :status, "公開状態" %>
    <%= form.select :status, [["下書き (draft)", "draft"], ["公開中 (published)", "published"]] %>
  </div>

  <div class="form-group">
    <%= form.label :thumbnail, "サムネイル画像" %>
    <p class="form-help">記事一覧のカードなどに表示される画像です。JPEG・PNG・WebP、5MB以下のファイルを選択してください。</p>
    <%= form.file_field :thumbnail, accept: Article::THUMBNAIL_ALLOWED_CONTENT_TYPES.join(",") %>
  </div>

  <div style="margin-top: 2rem; display: flex; gap: 1rem; align-items: center;">
    <%= form.submit "保存する", class: "btn btn-primary" %>
    <%= link_to "キャンセルして一覧へ戻る", admin_articles_path, class: "btn" %>
  </div>
<% end %>
