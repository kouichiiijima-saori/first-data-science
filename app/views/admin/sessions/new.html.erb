<h1>管理者ログイン</h1>

<% if flash[:alert].present? %>
  <p class="alert"><%= flash[:alert] %></p>
<% end %>

<%= form_with url: admin_login_path, method: :post, local: true do %>
  <div>
    <%= label_tag :email, "メールアドレス" %>
    <%= email_field_tag :email, @email, autocomplete: "email", required: true %>
  </div>

  <div>
    <%= label_tag :password, "パスワード" %>
    <%= password_field_tag :password, nil, autocomplete: "current-password", required: true %>
  </div>

  <%= submit_tag "ログイン" %>
<% end %>
