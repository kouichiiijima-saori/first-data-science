<div class="login-container">
  <h1 style="text-align: center; margin-bottom: 2rem;">管理者ログイン</h1>

  <%= form_with url: admin_login_path, method: :post, local: true do |f| %>
    <div class="form-group">
      <%= f.label :email, "メールアドレス" %>
      <%= f.email_field :email, value: @email, autocomplete: "email", required: true %>
    </div>

    <div class="form-group">
      <%= f.label :password, "パスワード" %>
      <%= f.password_field :password, autocomplete: "current-password", required: true %>
    </div>

    <div style="margin-top: 2rem;">
      <%= f.submit "ログイン", class: "btn btn-primary", style: "width: 100%;" %>
    </div>
  <% end %>
</div>
